APP_TIMEZONE=America/Lima

# Correo de la empresa que recibe las solicitudes
CONTACT_RECIPIENT_EMAIL=hflores07@gmail.com
CONTACT_RECIPIENT_NAME="PERU TRANSPORT & LOGISTIC E.I.R.L."

# Proveedor SMTP: gmail | outlook | hotmail
# Define automáticamente host/puerto/cifrado si no los sobreescribes abajo.
MAIL_PROVIDER=gmail

# Credenciales SMTP (usuario = tu correo completo; contraseña = App Password)
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD="REEMPLAZA_AQUI_TU_APP_PASSWORD"
MAIL_FROM_ADDRESS=tu-correo@gmail.com
MAIL_FROM_NAME="PERU TRANSPORT & LOGISTIC E.I.R.L."

# Opcional: sobreescribir preset del proveedor (dejar comentado para usar preset)
#MAIL_HOST=
#MAIL_PORT=
#MAIL_ENCRYPTION=

# ---------------------------------------------------------------------------
# PRESETS POR PROVEEDOR (referencia; no es necesario editarlos)
#
# GMAIL  (requiere App Password con 2FA activado):
#   MAIL_PROVIDER=gmail
#   MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_ENCRYPTION=tls
#   (o MAIL_PORT=465 MAIL_ENCRYPTION=ssl)
#
# HOTMAIL / OUTLOOK (contraseña de la cuenta o App Password):
#   MAIL_PROVIDER=outlook
#   MAIL_HOST=smtp-mail.outlook.com  MAIL_PORT=587  MAIL_ENCRYPTION=tls
# ---------------------------------------------------------------------------
